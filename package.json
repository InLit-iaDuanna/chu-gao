{
  "name": "sichuan-image-station",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:doctor": "PRISMA_LOG_LEVEL=silent tsx scripts/dev-check.ts",
    "build": "node scripts/generate-surface-masks.mjs && NEXT_PRIVATE_BUILD_WORKER=0 next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:chat": "vitest run --config vitest.chat.config.ts",
    "test:chat:db": "node scripts/test-chat-turns.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx workers/generation.worker.ts",
    "worker:chat": "node --env-file-if-exists=.env --import tsx workers/chat.worker.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-radio-group": "^1.4.5",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.6",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "eventsource-parser": "^4.1.2",
    "fflate": "0.8.2",
    "figma-squircle": "1.1.0",
    "geist": "^1.7.2",
    "ioredis": "^5.10.1",
    "jsonrepair": "3.15.0",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "prisma": "^6.16.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "15.5.18",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "jsdom": "26.1.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.4"
  }
}
