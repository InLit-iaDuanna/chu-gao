# 初稿 Chūgǎo Studio · 环境变量示例
#
# 这里只列出安卓客户端发布相关的变量；其余运行环境变量由部署平台注入，
# 不在此重复。GET /api/app/version 与 /download 页面读取以下配置，
# 未配置（或 APK 地址不可信）时对外视为“尚未上线”。

# 版本号（整数，必须 > 0 才视为已发布）
APP_ANDROID_LATEST_VERSION_CODE=0
# 版本名，例如 1.0.0
APP_ANDROID_LATEST_VERSION_NAME=
# 允许使用的最低版本号（整数，默认 1；不会超过 latest）
APP_ANDROID_MIN_VERSION_CODE=1
# APK 下载地址：必须 https，且 host 为 chugao.art 或其子域
APP_ANDROID_APK_URL=
# 安装包 SHA-256（64 位 hex），用于下载页校验
APP_ANDROID_APK_SHA256=
# 更新说明（纯文本，换行会被保留）
APP_ANDROID_NOTES=
# 发布时间（ISO 8601，例如 2026-11-21T10:00:00.000Z）
APP_ANDROID_PUBLISHED_AT=
