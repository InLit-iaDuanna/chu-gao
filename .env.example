# Database
POSTGRES_PASSWORD="local-postgres-password"
# Host-local URL for `pnpm dev`; Docker Compose overrides this inside containers.
DATABASE_URL="postgresql://app:local-postgres-password@localhost:5432/app?schema=public"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
SESSION_SECRET="replace-with-at-least-32-characters-local-secret"
# 需要跨 chugao.art 子域共享登录时设置；本地 localhost 留空即可。
SESSION_COOKIE_DOMAIN=".chugao.art"
# 登录、注册、应用和管理端统一到这个 origin，避免跨子域认证竞态。
AUTH_CANONICAL_HOST="chugao.art"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Initial admin bootstrap
ADMIN_EMAIL="admin@chugao.local"
ADMIN_PASSWORD="local-dev-password"
ADMIN_NAME="Admin"
ADMIN_IP_ALLOWLIST=""
ADMIN_IP_HEADER="x-real-ip"
DEFAULT_USER_CREDITS=100
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_CONVERSATION_PER_MIN=20
RATE_LIMIT_AI_TOOL_PER_MIN=20
RATE_LIMIT_PPT_PER_MIN=10
RATE_LIMIT_ADMIN_TEST_PER_MIN=5

# Local private storage
PRIVATE_STORAGE_DIR="./.data/storage"
S3_ENDPOINT=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=""
NEXT_IMAGE_REMOTE_HOSTS=""
PROVIDER_IMAGE_FETCH_ALLOWLIST=""
PROVIDER_IMAGE_DOWNLOAD_TIMEOUT_MS=30000
MAX_PROVIDER_IMAGE_DOWNLOAD_MB=20
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_BODY_MB=11
MAX_IMAGE_DIMENSION=16384
MAX_IMAGE_PIXELS=40000000
MAX_REFERENCE_IMAGES=16
SIGNED_URL_EXPIRES_SECONDS=3600
PPT_EXPORT_MAX_SLIDES=120
PPT_EXPORT_MAX_MB=300

# Generation runtime
GENERATION_TIMEOUT_MS=300000
PROVIDER_REQUEST_TIMEOUT_MS=120000
PROVIDER_ACCOUNT_MAX_ATTEMPTS=5
WORKER_CONCURRENCY=4
PROVIDER_CAPACITY_RETRY_MS=1500
STUCK_PENDING_MS=120000
STUCK_RUNNING_MS=600000
STUCK_MAX_ATTEMPTS=3
STUCK_RECOVERY_INTERVAL_MS=60000
WORKER_HEARTBEAT_INTERVAL_MS=15000

# DeepSeek API (for PPT prompt enhancement)
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Image provider seed (required for real image generation)
IMAGE2_PROVIDER_NAME="sub2api"
IMAGE2_PROVIDER_PROTOCOL="OPENAI_RESPONSES_IMAGE"
IMAGE2_WIRE_API="responses"
IMAGE2_BASE_URL=""
IMAGE2_API_KEY=""
IMAGE2_MODELS_SUPPORTED="sub2api-image"
IMAGE2_PRIORITY=100
IMAGE2_COST_MULTIPLIER=1
IMAGE2_ACCOUNT_CONCURRENCY=1
IMAGE2_PROVIDER_NOTE="OpenAI Responses image2 provider"
SUB2API_RESPONSES_MODEL="gpt-5.5"
SUB2API_IMAGE_TOOL_MODEL=""
SUB2API_RESPONSES_QUALITY=""
SUB2API_RESPONSES_TOOL_CHOICE=""
SUB2API_RESPONSES_SIZE_MODE=""

# Conversation model (optional env fallback; primary config lives in admin → AI 集成)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
CONVERSATION_API_KEY=""
CONVERSATION_BASE_URL="https://api.deepseek.com"
CONVERSATION_MODEL="deepseek-chat"
CONVERSATION_COMPILER_MODEL="gpt-5.5"
CONVERSATION_COMPILER_REASONING="low"
CONVERSATION_COMPILER_TIMEOUT_MS=20000

# Redis (optional, for rate limiting and queue)
REDIS_URL="redis://localhost:6379"
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_READY_TIMEOUT_MS=3000

# Email (optional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# 数据保留清理定时任务密钥（外部 cron 调用 /api/cron/retention 时用 Bearer 校验；留空则仅管理员手动触发）
CRON_SECRET=

LOG_LEVEL="info"
