FROM ghcr.io/astral-sh/uv:0.11.1@sha256:fc93e9ecd7218e9ec8fba117af89348eef8fd2463c50c13347478769aaedd0ce AS uv
FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
COPY --from=uv /uv /uvx /usr/local/bin/
ENV PYTHONUNBUFFERED=1 HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=* LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN sed -i 's|http://deb.debian.org/debian-security|https://mirrors.ustc.edu.cn/debian-security|g;s|http://deb.debian.org/debian|https://mirrors.ustc.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked apt-get update -o Acquire::Retries=2 && apt-get install -y --no-install-recommends curl git build-essential fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
ARG DEERFLOW_REV=cd0166ae76f8a05d2ef13ce665ec89b37584217f
RUN mkdir -p /opt/deerflow && curl --noproxy '*' -fsSL --retry 2 https://codeload.github.com/bytedance/deer-flow/tar.gz/${DEERFLOW_REV} | tar -xz --strip-components=1 -C /opt/deerflow
WORKDIR /opt/deerflow/backend
RUN sed -i 's|https://pypi.org/simple|https://mirrors.aliyun.com/pypi/simple/|g;s|https://files.pythonhosted.org/packages/|https://mirrors.aliyun.com/pypi/packages/|g' uv.lock
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --default-index https://mirrors.aliyun.com/pypi/simple/ --no-dev --no-default-groups && uv pip install --python .venv/bin/python --default-index https://mirrors.aliyun.com/pypi/simple/ python-pptx==1.0.2 python-docx==1.2.0
COPY services/research-runtime/requirements.office.lock /bridge/requirements.office.lock
RUN uv pip install --python .venv/bin/python --no-deps --default-index https://mirrors.aliyun.com/pypi/simple/ -r /bridge/requirements.office.lock
ENV PATH=/opt/deerflow/backend/.venv/bin:$PATH PYTHONPATH=/bridge:/opt/deerflow/backend RESEARCH_ENGINE=deerflow
WORKDIR /bridge
COPY services/research-runtime/app.py services/research-runtime/engine.py services/research-runtime/runtime_contracts.py services/research-runtime/chugao_tools.py services/research-runtime/proposal_export.py services/research-runtime/check-runtime.py ./
COPY services/research-runtime/skills ./skills
RUN python check-runtime.py && touch /bridge/.assembly-ready
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
