FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONUNBUFFERED=1 HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=* OTEL_SDK_DISABLED=true LANGSMITH_TRACING=false
ENV PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
RUN sed -i 's|http://deb.debian.org/debian-security|https://mirrors.ustc.edu.cn/debian-security|g;s|http://deb.debian.org/debian|https://mirrors.ustc.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked apt-get update -o Acquire::Retries=2 && apt-get install -y --no-install-recommends build-essential libxml2-dev libxslt1-dev && rm -rf /var/lib/apt/lists/*
RUN --mount=type=cache,target=/root/.cache/pip pip install --timeout 30 --retries 2 gpt-researcher==0.16.1 fastapi==0.128.0 uvicorn==0.40.0 httpx==0.28.1
COPY services/research-runtime/requirements.gptr.lock /bridge/requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip pip install --no-deps -r /bridge/requirements.lock || pip install --no-deps --index-url https://pypi.org/simple/ -r /bridge/requirements.lock
WORKDIR /bridge
COPY services/research-runtime/app.py services/research-runtime/engine.py services/research-runtime/runtime_contracts.py services/research-runtime/design_research.py services/research-runtime/check-runtime.py ./
ENV RESEARCH_ENGINE=gpt-researcher
RUN python check-runtime.py && touch /bridge/.assembly-ready
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
