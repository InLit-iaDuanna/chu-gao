FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY prisma ./prisma
RUN corepack enable \
  && pnpm config set fetch-timeout 600000 \
  && pnpm config set network-concurrency 4 \
  && pnpm install --frozen-lockfile --prod
RUN pnpm db:generate

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S nodejs && adduser -S worker -G nodejs
COPY --from=deps --chown=worker:nodejs /app/node_modules ./node_modules
COPY --from=deps --chown=worker:nodejs /app/package.json ./package.json
COPY --from=deps --chown=worker:nodejs /app/prisma ./prisma
COPY --chown=worker:nodejs tsconfig.json ./tsconfig.json
COPY --chown=worker:nodejs lib ./lib
COPY --chown=worker:nodejs workers ./workers
RUN mkdir -p .data/storage && chown -R worker:nodejs /app
USER worker
CMD ["./node_modules/.bin/tsx", "workers/generation.worker.ts"]
